# Copy this file to .env and paste keys there. Do not put real keys in this file.
# Do not add NEXT_PUBLIC_ to these names. The keys must stay on the server.

# USPTO Open Data Portal. Create it at https://data.uspto.gov/apis
USPTO_API_KEY=

# PatSnap Open Platform. Create it at https://open.patsnap.com
PATSNAP_API_KEY=

# Groq free tier. Create it at https://console.groq.com/keys
# Athena uses this only to decide whether a question is asking for restricted material.
GROQ_API_KEY=
